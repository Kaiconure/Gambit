    },
    "black_magic_nuke": {
      "max_hpp": 10,
      "max_tier": "III",
      "min_tier": "I",
      "frequency": 5
    },
    "use_aspir": {
      "max_mpp": 75,
      "frequency": 5,
      "max_ws_mpp": 50
    },
    "frontline_engagement": {
      "distance_offset": null,
      "angle": null
    },
