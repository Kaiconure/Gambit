{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "frontline_engagement": {
      "prioritize_melee_engagement": true,
      "angle": null,
      "distance": null,
      "engage_trusts": null,
      "camp": {
        "min_distance": 4,
        "max_distance": 20,
        "max_duration": 10,
        "zone": null,
        "location": null,
        "action_types": null,
        "wait": null
      }
    }
  },
  "actions": [
    {
      "commands": [
        "setVar('vars.frontline_engagement._distance', max(0.125, (vars.frontline_engagement.distance or 0.5) + (vars.frontline_engagement.distance_offset or 0)))"
      ],
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "when": [
        "vars.frontline_engagement.camp",
        "vars.frontline_engagement.camp.location",
        "vars.frontline_engagement.camp.zone and any(vars.frontline_engagement.camp.zone, zone_id, zone_name, zone_search)",
        "arrayCount(vars.frontline_engagement.camp.action_types) == 0 or any(actionType, vars.frontline_engagement.camp.action_types)",
        "-------------------------------------------------------------------------------------",
        "-- We'll only return to camp if we're within the configured range ",
        "distanceInRange(vars.frontline_engagement.camp.location, vars.frontline_engagement.camp.min_distance or 5, vars.frontline_engagement.camp.max_distance or 20)"
      ],
      "commands": [
        "logf('[%s] Returning to camp location (%.1f, %.1f)', actionType, vars.frontline_engagement.camp.location.x, vars.frontline_engagement.camp.location.y)",
        "move(vars.frontline_engagement.camp.location.x, vars.frontline_engagement.camp.location.y, vars.frontline_engagement.camp.max_duration)",
        "faceEnemy() and wait(vars.frontline_engagement.camp.wait or 1)"
      ],
      "comment": [
        "If we have an assigned camp location for this zone and we've moved too far from it, get back to it."
      ],
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "when": "bt and not facingEnemy()",
      "commands": "faceEnemy()",
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle",
      "comment": "Ensure we face the enemy immediately."
    },
    {
      "comment": [
        "=========================================================================",
        " This gambit ensures that the leader engages trusts in the fight before",
        " adhering to the configured engagement distance rules.",
        "========================================================================="
      ],
      "when": [
        "bt and me.is_party_leader",
        "vars.frontline_engagement.engage_trusts and waiting_for_trusts",
        "vars.frontline_engagement._distance > 2",
        "bt and bt.distance > 3",
        "not hasEffect('Bind')"
      ],
      "commands": [
        "log('getting closer for trusts!')",
        "follow(bt, 2)",
        "wait(max(2, min(bt.distance, 32) / 8))"
      ],
      "frequency": 0,
      "delay": 0
    },
    {
      "when": [
        "actionType == 'battle'",
        "bt and bt.distance <= vars.frontline_engagement._distance + 2",
        "canAlign(bt) and not aligned(bt, vars.frontline_engagement.angle, vars.frontline_engagement._distance)"
      ],
      "commands": [
        "align(bt, vars.frontline_engagement.angle, vars.frontline_engagement._distance) or postpone(10)"
      ],
      "frequency": 1,
      "scope": "battle",
      "delay": 2
    },
    {
      "when": "bt and bt.distance <= vars.frontline_engagement._distance and following(bt)",
      "commands": ["cancelFollow()", "faceEnemy()", "wait(0.5)"],
      "frequency": 1,
      "comment": "Stop following and face the enemy if we're close to the mob."
    },
    {
      "when": "bt and bt.distance <= vars.frontline_engagement._distance and not facingEnemy()",
      "commands": ["faceEnemy()", "wait(0.5)"],
      "frequency": 1,
      "comment": "Keep facing the enemy as we fight."
    },
    {
      "when": "bt and bt.distance > vars.frontline_engagement._distance and not following(bt)",
      "commands": [
        "faceEnemy()",
        "follow(bt, vars.frontline_engagement._distance)",
        "wait(0.5)"
      ],
      "frequency": 1,
      "comment": "Maintain a minimum distance from the enemy."
    },
    {
      "when": [
        "vars.frontline_engagement.prioritize_melee_engagement",
        "bt and bt.distance > (vars.frontline_engagement._distance + 2)",
        "not hasEffect('Bind')"
      ],
      "commands": [
        "not following(bt) and follow(bt, vars.frontline_engagement._distance) and log('Unexpected: Initiated melee range following')",
        "wait(1)"
      ],
      "comment": "Ensure that we get into melee range without executing later actions."
    }
  ]
}
