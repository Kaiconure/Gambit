{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "homepoint_on_death": {
      "block_on_buffs": [
        "Battlefield",
        "Voidwatcher",
        "Level Restriction",
        "Confrontation"
      ],
      "block_on_zones": [
        "-- Maquette Abdhaljs-LegionA",
        183,
        "-- Maquette Abdhaljs-LegionB",
        287,
        "-- Reisenjima Henge",
        292
      ]
    }
  },
  "macros": {
    "can_death_warp": [
      "not hasBuff(vars.homepoint_on_death.block_on_buffs) and not any(zone_id, vars.homepoint_on_death.block_on_zones)"
    ],
    "cannot_death_warp": [
      "hasBuff('Battlefield', 'Voidwatcher', 'Confrontation') or any(zone_id, vars.homepoint_on_death.block_on_zones)"
    ]
  },
  "actions": [
    {
      "when": ["me.hpp <= 0", "$macro:cannot_death_warp"],
      "commands": [
        "log('Death warp will not occur due to current conditions. Disabling Gambits.')",
        "sendCommand('gbt disable')"
      ]
    },
    {
      "when": ["me.hpp <= 0", "$macro:can_death_warp"],
      "commands": "log('Death has occurred. Disable automation within 5 minutes to avoid automatically returning to your homepoint.')",
      "frequency": 330
    },
    {
      "when": ["me.hpp <= 0", "$macro:can_death_warp"],
      "commands": [
        "log('Disabling all gambits and death warping...')",
        "sendCommand('gbt disable')",
        "deathWarp()"
      ],
      "name": "death_warp",
      "delay": 300,
      "comment": "This action can only be used if you're dead. Import this gambit into the [dead] actions section if you want to return to homepoint on death."
    }
  ]
}
