{
  "about": {
    "author": "@Kaiconure",
    "documentation": [
      "This gambit allows you to set up a multi-stage weapon skill/skillchain sequence."
    ]
  },
  "vars": {
    "ws": {
      "multi_stage": {
        "disabled": null,
        "stages": null,
        "settings_name": null
      },
      "multi_stage_settings": null
    }
  },
  "functions": [
    {
      "commands": [
        "sendCommand('gbtfn multi-stage-overrides') and wait(1)",
        "vars.ws.multi_stage.stages and \\",
        "  (log('Preparing to test multi-stage configuration...') and isNextMultiStageOpener(vars.ws.multi_stage) or log('Multi-stage test completed!')) or \\",
        "  (log('A valid multi-stage configuration was not found.'))"
      ],
      "name": "test/multi-stage",
      "silent": true,
      "max_iterations": 1
    }
  ],
  "actions": [
    {
      "import": "ws/terminal-reset"
    },
    {
      "import": "macros/skillchaining"
    },
    {
      "when": ["vars.ws.multi_stage.settings_name"],
      "commands": [
        "-----The first thing we'll do is apply any overrides.",
        "logf('Applying settings overrides for multi-stage skillchaining!')",
        "vars.ws.multi_stage or setVar('vars.ws.multi_stage', {})",
        "tableInherit(vars.ws.multi_stage, getVar('vars.ws.multi_stage_settings.' .. string(vars.ws.multi_stage.settings_name, '')), true)"
      ],
      "name": "multi-stage-overrides",
      "max_iterations": 1,
      "silent": true,
      "on_load": true
    },
    {
      "when": ["arrayCount(vars.ws.multi_stage.stages) == 0"],
      "commands": [
        "-----If there are no stages defined, we'll null out the stage variables and log that fact.",
        "setVar('vars.ws.multi_stage.stages', nil)",
        "log(_tgray('No weapon skill stages were defined!'))",

        "vars.ws.multi_stage.stages and \\",
        "  logf('Identified %s weapon skill stages!', _tblue(arrayCount(vars.ws.multi_stage.stages))) or \\",
        "  log(_tgray('No weapon skill stages were defined!'))"
      ],
      "on_load": true
    },
    {
      "when": ["vars.ws.multi_stage.stages"],
      "commands": [
        "-----There are stages, so log how many we've got defined.",
        "logf('Identified %s weapon skill stages!', _tblue(arrayCount(vars.ws.multi_stage.stages)))"
      ],
      "on_load": true
    },
    {
      "when": ["vars.ws.multi_stage.skillchain_delay"],
      "commands": [
        "logf('Configuring multi-stage skillchain delay to: %.1fs', vars.ws.multi_stage.skillchain_delay)",
        "sendCommand('gbt config -scd %.1f', vars.ws.multi_stage.skillchain_delay)"
      ],
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "when": [
        "not vars.ws.multi_stage.disabled",
        "vars.ws.multi_stage.stages and not vars.ws.multi_stage.stages_disabled",
        "isNextMultiStageCloser(vars.ws.multi_stage)",
        "$macro:can_close_sc"
      ],
      "commands": ["$macro:close_skillchain"]
    },
    {
      "when": [
        "not vars.ws.multi_stage.disabled",
        "vars.ws.multi_stage.stages and not vars.ws.multi_stage.stages_disabled",
        "$macro:can_open_sc",
        "isNextMultiStageOpener(vars.ws.multi_stage)"
      ],
      "commands": ["$macro:open_skillchain"]
    }
  ]
}
