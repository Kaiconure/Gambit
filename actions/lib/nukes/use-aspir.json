{
  "vars": {
    "^use_aspir": {
      "frequency": 10,
      "max_mpp": 80,
      "max_ws_mpp": 30,
      "spells": ["Aspir III", "Aspir II", "Aspir"],
      "targets": {
        "Air Elemental": true,
        "Apex Crab": true,
        "Apex Helm Elytra": true,
        "Apex Idle Drifter": true,
        "Asb": true,
        "Azure-toothed Clawberry": true,
        "Bozzetto's Avatar": true,
        "Bozzetto Conjurer": true,
        "Bozzetto Defiler": true,
        "Bozzetto Devout": true,
        "Bozzetto Disruptor": true,
        "Bozzetto Elementalist": true,
        "Bozzetto High Vicar": true,
        "Bozzetto Stormbringer": true,
        "Dark Elemental": true,
        "Darkness Elemental": true,
        "Earth Elemental": true,
        "Fire Elemental": true,
        "Ice Elemental": true,
        "Light Elemental": true,
        "Locus Armet Beetle": true,
        "Locus Ghost Crab": true,
        "Locus Tomb Worm": true,
        "Mukasura": true,
        "Perfidien": true,
        "Pil": true,
        "Plouton": true,
        "Rukh": true,
        "Sarbaz": true,
        "Shah": true,
        "Sprinkler": true,
        "Thunder Elemental": true,
        "Water Elemental": true,
        "Wazir": true
      }
    }
  },
  "actions": [
    {
      "when": [
        "bt and (vars.use_aspir.targets[bt.name] or (vars.use_aspir.targets[bt.name] == nil and vars.use_aspir.targets[bt.name:match('(%a+ Elemental)$') or '']))",
        "bt.distance <= 20",
        "me.mpp <= vars.use_aspir.max_mpp",
        "(me.mpp <= vars.use_aspir.max_ws_mpp and not skillchaining('Light', 'Darkness')) or not partyUsingWeaponSkill()",
        "canUse(vars.use_aspir.spells)"
      ],
      "comment": "Prefixed elementals inherit eligibility from their base elemental name. An explicit target entry, including false, takes precedence.",
      "commands": [
        "use(bt)",
        "postpone(vars.use_aspir.frequency)"
      ]
    }
  ]
}
