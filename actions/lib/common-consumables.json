{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "common_consumables": {
      "disabled": null,
      "escha_items": [
        "Silt Pouch",
        "Bead Pouch",
        "Frayed Sack (Pel)",
        "Frayed Sack (Fer)",
        "Frayed Sack (Tau)"
      ],
      "unm_items": [
        "Arke's Coffer",
        "Bakunawa's Coffer",
        "Belinda's Coffer",
        "Clawberry's Coffer",
        "Harold's Coffer",
        "Shedu's Coffer",
        "Sovereign's Coffer",
        "Vedrfolnir's Coffer"
      ],
      "woe_items": [
        "Frayed Sack (D)",
        "Frayed Sack (L)",
        "Frayed Pouch (A)",
        "Frayed Pouch (B)",
        "Frayed Pouch (D)",
        "Frayed Pouch (G)",
        "Frayed Pouch (R)"
      ]
    }
  },
  "actions": [
    {
      "when": ["not vars.common_consumables.disabled"],
      "commands": [
        "setVar('vars.common_consumables.all_items', {})",
        "not vars.common_consumables.escha_items_disabled and arrayAppend(vars.common_consumables.all_items, vars.common_consumables.escha_items)",
        "not vars.common_consumables.unm_items_disabled and arrayAppend(vars.common_consumables.all_items, vars.common_consumables.unm_items)",
        "not vars.common_consumables.woe_items_disabled and arrayAppend(vars.common_consumables.all_items, vars.common_consumables.woe_items)",
        "arrayCount(vars.common_consumables.all_items) == 0 and log('No common consumables were configured for use.')",
        "arrayCount(vars.common_consumables.all_items) ~= 0 and log('Configured', arrayCount(vars.common_consumables.all_items), 'common consumable type(s) to use when present.')"
      ],
      "delay": 0,
      "frequency": "infinity",
      "miss_frequency": "infinity"
    },
    {
      "when": [
        "not vars.common_consumables.disabled",
        "not bt or not bt.is_engaged",
        "freeInventorySlots() > 0",
        "arrayCount(vars.common_consumables.all_items) > 0",
        "canUseItem(vars.common_consumables.all_items)"
      ],
      "commands": ["useItem(me)"],
      "miss_frequency": 30,
      "scope": "battle"
    }
  ]
}
