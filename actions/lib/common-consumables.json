{
  "vars": {
    "common_consumables": {
      "disabled": null,
      "escha_items": [
        "Silt Pouch",
        "Bead Pouch",
        "Frayed Sack (Pel)",
        "Frayed Sack (Fer)",
        "Frayed Sack (Tau)"
      ],
      "unm_items": [
        "Arke's Coffer",
        "Bakunawa's Coffer",
        "Belinda's Coffer",
        "Clawberry's Coffer",
        "Harold's Coffer",
        "Shedu's Coffer",
        "Sovereign's Coffer",
        "Vedrfolnir's Coffer"
      ],
      "woe_items": [
        "Frayed Sack (D)",
        "Frayed Sack (L)",
        "Frayed Pouch (A)",
        "Frayed Pouch (B)",
        "Frayed Pouch (D)",
        "Frayed Pouch (G)",
        "Frayed Pouch (R)"
      ]
    }
  },
  "actions": [
    {
      "when": [
        "not vars.common_consumables.disabled and not vars.common_consumables.escha_items_disabled",
        "canUseItem(vars.common_consumables.escha_items) and freeInventorySlots() > 0"
      ],
      "commands": ["useItem(me)"],
      "comment": "Escha Items"
    },
    {
      "when": [
        "not vars.common_consumables.disabled and not vars.common_consumables.unm_items_disabled",
        "canUseItem(vars.common_consumables.unm_items) and freeInventorySlots() > 0"
      ],
      "commands": ["useItem(me)"],
      "comment": "UNM Items"
    },
    {
      "when": [
        "not vars.common_consumables.disabled and not vars.common_consumables.woe_items_disabled",
        "canUseItem(vars.common_consumables.woe_items) and freeInventorySlots() > 0"
      ],
      "commands": ["useItem(me)"],
      "comment": "Walk of Echoes Items"
    }
  ]
}
