{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "use_cover": {
      "targets": null,
      "trigger_hpp": 30
    }
  },
  "actions": [
    {
      "when": [
        "canUse('Cover')",
        "partyByName(vars.use_cover.targets)",
        "not member.is_me",
        "member.distance <= 10 and member.hpp <= vars.use_cover.trigger_hpp"
      ],
      "commands": ["use(member)"],
      "frequency": 2
    }
  ]
}
