{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "^use_rolls": {
      "alignment": {
        "enabled": false,
        "targets": [],
        "distance": 5,
        "range": 7,
        "duration": 3,
        "timeout": 30
      },
      "rolls": ["Corsair's Roll", "Chaos Roll"],
      "allow_crooked_cards": ["Corsair's Roll"],
      "gear": {
        "roll": null,
        "battle": null
      },
      "logic": {
        "Allies' Roll": {
          "snake_eye": [2, 10],
          "double_up": [1, 2, 4, 5],
          "data": {
            "lucky": 3,
            "unlucky": 10,
            "summary": "Enhances Skillchain damage and skillchain accuracy for party members within area of effect."
          }
        },
        "Blitzer's Roll": {
          "snake_eye": [3, 9, 10],
          "double_up": [1, 2, 3, 5],
          "data": {
            "lucky": 4,
            "unlucky": 9,
            "summary": "Reduces melee attack delay for party members within area of effect."
          }
        },
        "Bolter's Roll": {
          "snake_eye": [2, 9, 10],
          "double_up": [1, 2, 4, 5],
          "data": {
            "lucky": 3,
            "unlucky": 9,
            "summary": "Increases Movement Speed for party members within area of effect."
          }
        },
        "Chaos Roll": {
          "snake_eye": [3, 8, 10],
          "double_up": [1, 2, 3, 5],
          "data": {
            "lucky": 4,
            "unlucky": 8,
            "sub": "DRK",
            "summary": "Enhances attacks for party members within area of effect."
          }
        },
        "Choral Roll": {
          "snake_eye": [1, 6, 10],
          "double_up": [1, 3, 4, 5, 6],
          "data": {
            "lucky": 2,
            "unlucky": 6,
            "sub": "BRD",
            "summary": "Decreases spell interruption rate for party members within area of effect."
          }
        },
        "Corsair's Roll": {
          "snake_eye": [4, 9, 10],
          "double_up": [1, 2, 3, 4],
          "data": {
            "lucky": 5,
            "unlucky": 9,
            "summary": "Increases the amount of Experience Points earned by party members within area of effect."
          }
        },
        "Fighter's Roll": {
          "snake_eye": [4, 9, 10],
          "double_up": [1, 2, 3, 4],
          "data": {
            "lucky": 5,
            "unlucky": 9,
            "sub": "WAR",
            "summary": "Improves \"Double Attack\" rate for party members within area of effect."
          }
        },
        "Evoker's Roll": {
          "snake_eye": [4, 9, 10],
          "double_up": [1, 2, 3, 4],
          "data": {
            "lucky": 5,
            "unlucky": 9,
            "sub": "SMN",
            "summary": "Gradually restores MP for party members within area of effect."
          }
        },
        "Healer's Roll": {
          "snake_eye": [2, 7, 10],
          "double_up": [1, 2, 4, 5],
          "data": {
            "lucky": 3,
            "unlucky": 7,
            "sub": "WHM",
            "summary": "Increases potency of \"Cure\" effect received for party members within area of effect."
          }
        },
        "Hunter's Roll": {
          "snake_eye": [3, 8, 10],
          "double_up": [1, 2, 3, 5],
          "data": {
            "lucky": 4,
            "unlucky": 8,
            "sub": "RNG",
            "summary": "Enhances accuracy and ranged accuracy for party members within area of effect."
          }
        },
        "Samurai Roll": {
          "snake_eye": [1, 6, 10],
          "double_up": [1, 3, 4, 5, 6],
          "data": {
            "lucky": 2,
            "unlucky": 6,
            "sub": "SAM",
            "summary": "Enhances \"Store TP\" effect for party members within area of effect."
          }
        },
        "Tactician's Roll": {
          "snake_eye": [4, 8, 10],
          "double_up": [1, 2, 3, 4],
          "data": {
            "lucky": 5,
            "unlucky": 8,
            "summary": "Grants a \"Regain\" effect to party members within area of effect."
          }
        },
        "Warlock's Roll": {
          "snake_eye": [3, 8, 10],
          "double_up": [1, 2, 3, 5],
          "data": {
            "lucky": 4,
            "unlucky": 8,
            "sub": "RDM",
            "summary": "Enhances magic accuracy for party members within area of effect."
          }
        },
        "Wizard's Roll": {
          "snake_eye": [4, 9, 10],
          "double_up": [1, 2, 3, 4],
          "data": {
            "lucky": 5,
            "unlucky": 9,
            "sub": "BLM",
            "summary": "Enhances magic attack for party members within area of effect."
          }
        }
      }
    }
  },
  "comments": [
    "Optional use_rolls.alignment: enabled defaults false; targets are party selectors in preference order.",
    "distance is approach distance, range is accepted recipient distance (default 7 yalms), duration bounds each move.",
    "timeout bounds the shared movement reservation across the roll and Double-Up sequence; it is not extended by Double-Up.",
    "Only the selected recipient is range-checked. Keep other intended recipients nearby; this is not a group coverage guarantee.",
    "Use distance <= range, and a range safely inside your actual roll radius. Context movement helpers honor the reservation in idle and battle."
  ],
  "macros": {
    "roll_alignment": [
      "not vars.use_rolls.alignment.enabled or (partyAnchorByName(vars.use_rolls.alignment.targets, 30, true) and not hasBuff('Bind', 'Sleep', 'Stun', 'Petrification', 'Terror') and (member.distance <= vars.use_rolls.alignment.range or align(member, nil, vars.use_rolls.alignment.distance, vars.use_rolls.alignment.duration, true))) or execute('releaseMovement(); postpone(10); return false')"
    ],
    "roll_alignment_window": [
      "not vars.use_rolls.alignment.enabled or resumeMovement(vars.use_rolls.alignment.timeout)"
    ]
  },
  "actions": [
    {
      "movement_owner": "corsair-rolls",
      "when": [
        "hasMovementReservation()",
        "not vars.use_rolls.alignment.enabled or (getLatestRoll() and latestRoll.name == vars.use_rolls._alignment_roll and vars.use_rolls.logic[latestRoll.name] and not any(latestRoll.count, vars.use_rolls.logic[latestRoll.name].double_up or {}) and not any(latestRoll.count, vars.use_rolls.logic[latestRoll.name].snake_eye or {}))"
      ],
      "commands": ["releaseMovement()"],
      "frequency": 1
    },
    {
      "movement_owner": "corsair-rolls",
      "when": [
        "iterate(vars.use_rolls.rolls)",
        "canUse(result) and not hasEffectOf(result)",
        "not vars.use_rolls.alignment.enabled or reserveMovement(vars.use_rolls.alignment.timeout)",
        "$macro:roll_alignment"
      ],
      "commands": [
        "vars.use_rolls.alignment.enabled and setVar('use_rolls._alignment_roll', result)",
        "any(result, vars.use_rolls.allow_crooked_cards) and canUse('Crooked Cards') and use(me) and wait(0.5)",
        "vars.use_rolls.gear and vars.use_rolls.gear.roll and equipMany(vars.use_rolls.gear.roll)",
        "use(me, result)",
        "vars.use_rolls.logic[result] and vars.use_rolls.logic[result].data and vars.use_rolls.logic[result].data.summary and log(result .. ':', vars.use_rolls.logic[result].data.summary)",
        "wait(1)",
        "vars.use_rolls.gear and vars.use_rolls.gear.battle and equipMany(vars.use_rolls.gear.battle)"
      ],
      "frequency": 15
    },
    {
      "movement_owner": "corsair-rolls",
      "when": [
        "canUse('Snake Eye') and canUse('Double-Up')",
        "getLatestRoll()",
        "vars.use_rolls.logic[latestRoll.name] and vars.use_rolls.logic[latestRoll.name].snake_eye",
        "any(latestRoll.count, vars.use_rolls.logic[latestRoll.name].snake_eye)",
        "$macro:roll_alignment_window",
        "$macro:roll_alignment"
      ],
      "commands": [
        "vars.use_rolls.alignment.enabled and setVar('use_rolls._alignment_roll', latestRoll.name)",
        "log('Rolling snake eyes on', latestRoll.name, 'from', latestRoll.count)",
        "use(me, 'Snake Eye')",
        "wait(1.0)",
        "use(me, 'Double-Up')",
        "wait(1.0)"
      ]
    },
    {
      "movement_owner": "corsair-rolls",
      "when": [
        "canUse('Double-Up')",
        "getLatestRoll()",
        "vars.use_rolls.logic[latestRoll.name] and vars.use_rolls.logic[latestRoll.name].double_up",
        "any(latestRoll.count, vars.use_rolls.logic[latestRoll.name].double_up)",
        "$macro:roll_alignment_window",
        "$macro:roll_alignment"
      ],
      "commands": [
        "vars.use_rolls.alignment.enabled and setVar('use_rolls._alignment_roll', latestRoll.name)",
        "log('Doubling up on', latestRoll.name, 'from', latestRoll.count)",
        "vars.use_rolls.gear and vars.use_rolls.gear.roll and equipMany(vars.use_rolls.gear.roll)",
        "use(me)",
        "wait(1)",
        "vars.use_rolls.gear and vars.use_rolls.gear.battle and equipMany(vars.use_rolls.gear.battle)"
      ]
    },
    {
      "movement_owner": "corsair-rolls",
      "when": ["hasEffect('Bust')", "canUse('Fold')"],
      "commands": ["log('Busted, Folding!')", "use(me)", "wait(1)"],
      "frequency": 5
    }
  ]
}
