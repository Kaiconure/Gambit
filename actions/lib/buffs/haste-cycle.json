{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "haste_cycle": {
      "spells": ["Haste II", "Haste"],
      "targets": ["me"]
    }
  },
  "actions": [
    {
      "when": [
        "arrayCount(vars.haste_cycle.targets) > 0",
        "hasSpell(vars.haste_cycle.spells) and canUse(spell)",
        "partyByName(vars.haste_cycle.targets) and member.in_spell_range and not hasEffectOf(member, 'use-strict', spell)"
      ],
      "commands": [
        "useSpell()",
        "postpone((spellRecast(spell.name) or 0) + 5)"
      ],
      "frequency": 1
    }
  ]
}
