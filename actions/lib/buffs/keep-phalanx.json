{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "^keep_phalanx": {
      "disabled": null,
      "spells": ["Phalanx II", "Phalanx"],
      "targets": ["me"]
    }
  },
  "actions": [
    {
      "comments": [
        "Use the configured spell preference for self; other party members require Phalanx II."
      ],
      "when": [
        "not vars.keep_phalanx.disabled",
        "partyByName(vars.keep_phalanx.targets)",
        "member.is_participant and member.valid_target",
        "(member.is_me and hasSpell(vars.keep_phalanx.spells)) or (not member.is_me and hasSpell('Phalanx II'))",
        "not hasEffectOf(member, spell) and canUse(spell)"
      ],
      "commands": [
        "use(member)",
        "postpone((spellRecast(spell.name) or 0) + 10)"
      ],
      "frequency": 10
    }
  ]
}
