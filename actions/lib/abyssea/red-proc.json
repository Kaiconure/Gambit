{
  "actions": [
    {
      "import": "macros/skillchaining"
    },
    {
      "commands": [
        "setVar('vars.abyssea.red_proc._allowed', not vars.abyssea.red_proc.bypass_auto_init)",
        "setVar('vars.abyssea.red_proc._rotation', nil)"
      ],
      "comment": "Initialize once per battle; abyssea/red/use enables a manual search after engagement.",
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "commands": [
        "setVar('vars.abyssea.red_proc._weapon_set_name', vars.abyssea.red_proc.weapon_set_name or vars.abyssea.weapon_set_name or 'weapons')",
        "setVar('vars.abyssea.red_proc._weapons', arrayLength(vars.abyssea.red_proc[vars.abyssea.red_proc._weapon_set_name]) > 0 and vars.abyssea.red_proc[vars.abyssea.red_proc._weapon_set_name] or vars.abyssea[vars.abyssea.red_proc._weapon_set_name])",
        "abyssea.runRedProc({state=vars.abyssea.red_proc, enabled=vars.abyssea.red_proc._allowed, is_active=\"vars.abyssea.weapon_proc == 'red'\", all_ws=vars.abyssea.red_proc.all_ws, weapons=vars.abyssea.red_proc._weapons, weapon_set_name=vars.abyssea.red_proc._weapon_set_name, on_stagger=vars.abyssea.red_proc.on_stagger, allow_outside_abyssea=vars.abyssea.allow_outside_abyssea, swap_delay=vars.abyssea.red_proc.swap_delay, refresh_delay=vars.abyssea.red_proc.refresh_delay, equip_timeout=vars.abyssea.red_proc.equip_timeout, empty_pass_delay=vars.abyssea.red_proc.empty_pass_delay, ws_allow_list=vars.abyssea.ws_allow_list, ws_black_list=vars.abyssea.ws_black_list})"
      ],
      "comment": "Hints narrow the weapon/WS rotation; confirmed red stagger applies on_stagger policy.",
      "delay": 1,
      "frequency": 0,
      "scope": "battle",
      "when": [
        "vars.abyssea.weapon_proc == 'red'",
        "vars.abyssea.red_proc._allowed",
        "bt"
      ]
    }
  ],
  "functions": [
    {
      "commands": [
        "setVar('vars.abyssea.weapon_proc', 'red')",
        "setVar('vars.abyssea.red_proc._allowed', true)",
        "setVar('vars.abyssea.red_proc._rotation', nil)",
        "log('Allowing initialization of red proc weapon skills for this battle.')",
        "not me.is_engaged and logArray(usableWeaponSkills(vars.abyssea.red_proc.all_ws))"
      ],
      "max_iterations": 1,
      "miss_frequency": 120,
      "name": "abyssea/red/use",
      "silent": true
    }
  ],
  "vars": {
    "^abyssea": {
      "allow_outside_abyssea": false,
      "red_proc": {
        "all_ws": [
          "Cyclone",
          "Energy Drain",
          "Red Lotus Blade",
          "Seraph Blade",
          "Freezebite",
          "Shadow of Death",
          "Raiden Thrust",
          "Blade: Ei",
          "Tachi: Jinpu",
          "Tachi: Koki",
          "Seraph Strike",
          "Earth Crusher",
          "Sunburst"
        ],
        "on_stagger": "stop",
        "reference": "https://www.bg-wiki.com/ffxi/Category:Abyssea#Red"
      },
      "weapon_proc": "none"
    }
  }
}
