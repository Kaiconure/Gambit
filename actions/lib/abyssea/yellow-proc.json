{
  "actions": [
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc._yellow_rotation', nil)",
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.used_count', 0)",
        "setVar('vars.abyssea.yellow_proc.usable_count', 0)",
        "setVar('vars.abyssea.yellow_proc.all_spells', {})",
        "setVar('vars.abyssea.yellow_proc.usable_spells', {})",
        "log('Resetting yellow proc state.')"
      ],
      "comment": "This clears the list of already-tried spells at the start of any fight.",
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "commands": [
        "$macro:initialize_abyssea_yellow"
      ],
      "comment": "Resets the current spell pool based on the day of the week.",
      "delay": 0,
      "frequency": "infinity",
      "max_iterations": 1,
      "name": "abyssea/yellow/show",
      "scope": "battle",
      "when": [
        "not vars.abyssea.yellow_proc.bypass_auto_init or runningAsFunction()"
      ]
    },
    {
      "commands": [
        "abyssea.runYellowProc({state=vars.abyssea.yellow_proc, spells=vars.abyssea.yellow_proc.all_spells, tools=vars.abyssea.yellow_proc.tools, on_stagger=vars.abyssea.yellow_proc.on_stagger, allow_outside_abyssea=vars.abyssea.allow_outside_abyssea, ws_allow_list=vars.abyssea.ws_allow_list, ws_black_list=vars.abyssea.ws_black_list})"
      ],
      "comment": "Repeat ready yellow candidates; hints filter their spell element and yellow stagger applies completion policy.",
      "delay": 2,
      "frequency": 6,
      "miss_frequency": 2,
      "scope": "battle",
      "when": ["bt", "arrayLength(vars.abyssea.yellow_proc.all_spells) > 0"]
    },
    {
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      },
      "imports": [
        "ninjutsu/debuffs/keep-kurayami",
        "ninjutsu/nukes/use-doton",
        "ninjutsu/nukes/use-huton",
        "ninjutsu/nukes/use-hyoton",
        "ninjutsu/nukes/use-katon",
        "ninjutsu/nukes/use-raiton",
        "ninjutsu/nukes/use-suiton"
      ]
    }
  ],
  "functions": [
    {
      "name": "abyssea/yellow/use",
      "commands": ["$macro:initialize_abyssea_yellow"],
      "max_iterations": 1,
      "silent": true,
      "comment": "Initialize the combined yesterday/today/tomorrow yellow spell pool."
    },
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc._yellow_rotation', nil)",
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.day)]]\\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', vars.abyssea.yellow_proc.days_by_id[string(game_time.day)], 'spells for today.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "comments": [
        " ================================================================================ ",
        "  Identifies and prepares the usable YELLOW PROC spells for TODAY.",
        " ================================================================================ "
      ],
      "max_iterations": 1,
      "name": "abyssea/yellow/use-today"
    },
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc._yellow_rotation', nil)",
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.yesterday)]]\\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', vars.abyssea.yellow_proc.days_by_id[string(game_time.yesterday)], 'spells for yesterday.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "comments": [
        " ================================================================================ ",
        "  Identifies and prepares the usable YELLOW PROC spells for YESTERDAY.",
        " ================================================================================ "
      ],
      "max_iterations": 1,
      "name": "abyssea/yellow/use-yesterday"
    },
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc._yellow_rotation', nil)",
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.tomorrow)]]\\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', vars.abyssea.yellow_proc.days_by_id[string(game_time.tomorrow)], 'spells for tomorrow.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "comments": [
        " ================================================================================ ",
        "  Identifies and prepares the usable YELLOW PROC spells for TOMORROW.",
        " ================================================================================ "
      ],
      "max_iterations": 1,
      "name": "abyssea/yellow/use-tomorrow"
    }
  ],
  "macros": {
    "initialize_abyssea_yellow": [
      "setVar('vars.abyssea.yellow_proc._yellow_rotation', nil)",
      "setVar('vars.abyssea.yellow_proc.used_spells', {})",
      "setVar('vars.abyssea.yellow_proc.used_count', 0)",
      "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.day)]], vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.yesterday)]], vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.tomorrow)]])))",
      "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
      "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
      "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC spells across yesterday/today/tomorrow.')",
      "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
    ]
  },
