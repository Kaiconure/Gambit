        "functions": {
          "Kurayami: Ni": "keep_kurayami",
          "Doton: Ni": "use_doton",
          "Huton: Ni": "use_huton",
          "Hyoton: Ni": "use_hyoton",
          "Katon: Ni": "use_katon",
          "Raiton: Ni": "use_raiton",
          "Suiton: Ni": "use_suiton"
        },
        "reference": "https://www.bg-wiki.com/ffxi/Category:Abyssea#Yellow"
      }
    }
  },
  "actions": [
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.used_count', 0)",
        "setVar('vars.abyssea.yellow_proc.usable_count', 0)",
        "setVar('vars.abyssea.yellow_proc.all_spells', {})",
        "setVar('vars.abyssea.yellow_proc.usable_spells', {})",
        "log('Resetting yellow proc state.')"
      ],
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle",
      "comment": "This clears the list of already-tried spells at the start of any fight."
    },
    {
      "when": [
        "not vars.abyssea.yellow_proc.bypass_auto_init or runningAsFunction()"
      ],
      "commands": [
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.day)]], \\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.yesterday)]], \\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.tomorrow)]] \\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', game_time.day_name, 'spells.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "name": "abyssea/yellow/show",
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle",
      "max_iterations": 1,
      "comment": "Resets the current spell pool based on the day of the week."
    },
    {
      "when": [
        "hasAllFieldNames(vars.abyssea.yellow_proc.used_spells, vars.abyssea.yellow_proc.usable_spells)"
      ],
      "commands": ["log('All applicable YELLOW PROC spells have been used!')"],
      "delay": 5,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "when": [
        "bt",
        "setVar('vars.abyssea.yellow_proc._next_spell', arrayFirstMissing(vars.abyssea.yellow_proc.usable_spells, vars.abyssea.yellow_proc.used_spells))",
        "canUseSpell(vars.abyssea.yellow_proc._next_spell)",
        "not vars.abyssea.yellow_proc.functions[spell.name]"
      ],
      "commands": [
        "log('Casting YELLOW PROC spell:', spell.name)",
        "useSpell(bt) and setVarField('vars.abyssea.yellow_proc.used_spells', spell.name, true) and varIncrement('vars.abyssea.yellow_proc.used_count')"
      ],
      "delay": 2,
      "frequency": 6,
      "miss_frequency": 6
    },
    {
      "when": [
        "bt",
        "setVar('vars.abyssea.yellow_proc._next_spell', arrayFirstMissing(vars.abyssea.yellow_proc.usable_spells, vars.abyssea.yellow_proc.used_spells))",
        "canUseSpell(vars.abyssea.yellow_proc._next_spell)",
        "vars.abyssea.yellow_proc.functions[spell.name]"
      ],
      "commands": [
        "log('Invoking YELLOW PROC spell:', spell.name, 'with function:', vars.abyssea.yellow_proc.functions[spell.name])",
        "sendCommand('gbtfn %s', vars.abyssea.yellow_proc.functions[spell.name]) and wait(2) and setVarField('vars.abyssea.yellow_proc.used_spells', spell.name, true) and varIncrement('vars.abyssea.yellow_proc.used_count')"
      ],
      "delay": 2,
      "frequency": 6,
      "miss_frequency": 6
    },
    {
      "import": "ninjutsu/debuffs/keep-kurayami",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-doton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-huton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-hyoton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-katon",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-raiton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-suiton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    }
  ],
  "functions": [
    {
      "comments": [
        " ================================================================================ ",
        "  Identifies and prepares the usable YELLOW PROC spells for TODAY.",
        " ================================================================================ "
      ],
      "commands": [
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.day)]]\\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', vars.abyssea.yellow_proc.days_by_id[string(game_time.day)], 'spells for today.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "name": "abyssea/yellow/use-today",
      "max_iterations": 1
    },
    {
      "comments": [
        " ================================================================================ ",
        "  Identifies and prepares the usable YELLOW PROC spells for YESTERDAY.",
        " ================================================================================ "
      ],
      "commands": [
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.yesterday)]]\\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', vars.abyssea.yellow_proc.days_by_id[string(game_time.yesterday)], 'spells for yesterday.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "name": "abyssea/yellow/use-yesterday",
      "max_iterations": 1
    },
    {
      "comments": [
        " ================================================================================ ",
        "  Identifies and prepares the usable YELLOW PROC spells for TOMORROW.",
        " ================================================================================ "
      ],
      "commands": [
        "setVar('vars.abyssea.yellow_proc.used_spells', {})",
        "setVar('vars.abyssea.yellow_proc.all_spells', randomize(arrayMerge(\\",
        "    vars.abyssea.yellow_proc.spells_by_day[vars.abyssea.yellow_proc.days_by_id[string(game_time.tomorrow)]]\\",
        ")))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "setVar('vars.abyssea.yellow_proc.usable_count', arrayCount(vars.abyssea.yellow_proc.usable_spells))",
        "log('Identified', vars.abyssea.yellow_proc.usable_count, 'usable YELLOW PROC', vars.abyssea.yellow_proc.days_by_id[string(game_time.tomorrow)], 'spells for tomorrow.')",
        "vars.abyssea.yellow_proc.usable_count > 0 and logArray(vars.abyssea.yellow_proc.usable_spells)"
      ],
      "name": "abyssea/yellow/use-tomorrow",
      "max_iterations": 1
    }
  ]
}
