          ],
          [
            "Drain",
            "Aspir",
            "Dispel",
            "Bio II",
            "Kurayami: Ni",
            "Light Threnody",
            "Eyes On Me"
          ]
        ],
        "functions": {
          "Kurayami: Ni": "keep_kurayami",
          "Doton: Ni": "use_doton",
          "Huton: Ni": "use_huton",
          "Hyoton: Ni": "use_hyoton",
          "Katon: Ni": "use_katon",
          "Raiton: Ni": "use_raiton",
          "Suiton: Ni": "use_suiton"
        },
        "reference": "https://www.bg-wiki.com/ffxi/Category:Abyssea#Yellow"
      }
    }
  },
  "actions": [
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc.used_spells', nil)",
        "setVar('vars.abyssea.yellow_proc.used_count', 0)",
        "setVar('vars.abyssea.yellow_proc.all_spells', [])",
        "setVar('vars.abyssea.yellow_proc.usable_spells', [])"
      ],
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle",
      "comment": "This clears the list of already-tried spells at the start of any fight."
    },
    {
      "commands": [
        "setVar('vars.abyssea.yellow_proc.all_spells', arrayMerge(vars.abyssea.yellow_proc.day_spells[game_time.day + 1], vars.abyssea.yellow_proc.day_spells[game_time.yesterday + 1], vars.abyssea.yellow_proc.day_spells[game_time.tomorrow + 1]))",
        "setVar('vars.abyssea.yellow_proc.usable_spells', usableSpells(vars.abyssea.yellow_proc.all_spells))",
        "log('Identified', arrayCount(vars.abyssea.yellow_proc.usable_spells), 'usable YELLOW PROC', game_time.day_name, 'spell(s)!')"
      ],
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle",
      "comment": "Resets the current spell pool based on the day of the week."
    },
    {
      "when": [
        "hasAllFieldNames(vars.abyssea.yellow_proc.used_spells, vars.abyssea.yellow_proc.usable_spells)"
      ],
      "commands": ["log('All applicable YELLOW PROC spells have been used!')"],
      "delay": 5,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "when": [
        "bt",
        "iterate(vars.abyssea.yellow_proc.usable_spells)",
        "canUseSpell(result)",
        "not getVarField('vars.abyssea.yellow_proc.used_spells', result)"
      ],
      "commands": [
        "log('Using YELLOW PROC spell:', spell.name)",
        "(vars.abyssea.yellow_proc.functions[spell.name] and sendCommand('gbtfn %s', vars.abyssea.yellow_proc.functions[spell.name]) and wait(2) or useSpell(bt)) and setVarField('vars.abyssea.yellow_proc.used_spells', result, true) and varIncrement('vars.abyssea.yellow_proc.used_count')"
      ],
      "delay": 7,
      "frequency": 10
    },
    {
      "import": "ninjutsu/debuffs/keep-kurayami",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-doton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-huton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-hyoton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-katon",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-raiton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    },
    {
      "import": "ninjutsu/nukes/use-suiton",
      "filter": {
        "main_jobs": ["NIN"],
        "sub_jobs": ["NIN"]
      }
    }
  ]
}
