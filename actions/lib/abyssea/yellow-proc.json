        "huton": {
          "spells": ["Huton: Ni"]
        },
        "hyoton": {
          "spells": ["Hyoton: Ni"]
        },
        "katon": {
          "spells": ["Katon: Ni"]
        },
        "raiton": {
          "spells": ["Raiton: Ni"]
        },
        "suiton": {
          "spells": ["Suiton: Ni"]
        }
      }
    },
    "abyssea": {
      "yellow_proc": {
        "day_order": [
          "Firesday",
          "Earthsday",
          "Watersday",
          "Windsday",
          "Iceday",
          "Lightningday",
          "Lightsday",
          "Darksday"
        ],
        "day_spells": [
          [
            "Fire III",
            "Fire IV",
            "Firaga III",
            "Flare",
            "Katon: Ni",
            "Ice Threnody",
            "Heat Breath"
          ],
          [
            "Stone III",
            "Stone IV",
            "Stonega III",
            "Quake",
            "Doton: Ni",
            "Lightning Threnody",
            "Magnetite Cloud"
          ],
          [
            "Water III",
            "Water IV",
            "Waterga III",
            "Flood",
            "Suiton: Ni",
            "Fire Threnody",
            "Maelstrom"
          ],
          [
            "Aero III",
            "Aero IV",
            "Aeroga III",
            "Tornado",
            "Huton: Ni",
            "Earth Threnody",
            "Mysterious Light"
          ],
          [
            "Blizzard III",
