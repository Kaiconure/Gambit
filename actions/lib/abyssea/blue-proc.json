{
  "actions": [
    {
      "import": "macros/skillchaining"
    },
    {
      "commands": [
        "setVar('vars.abyssea.blue_proc._allowed', not vars.abyssea.blue_proc.bypass_auto_init)",
        "setVar('vars.abyssea.blue_proc._blue_rotation', nil)",
        "setVar('vars.abyssea.blue_proc.all_ws', {})"
      ],
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle"
    },
    {
      "commands": [
        "setVar('vars.abyssea.blue_proc._blue_rotation', nil)",
        "((game_time.hour - 6 ) % 24 < 8) and setVar('vars.abyssea.blue_proc.all_ws', vars.abyssea.blue_proc.ws_0614)",
        "((game_time.hour - 6 ) % 24 >= 8 and (game_time.hour - 6 ) % 24 < 16) and setVar('vars.abyssea.blue_proc.all_ws', vars.abyssea.blue_proc.ws_1422)",
        "((game_time.hour - 6 ) % 24 >= 16) and setVar('vars.abyssea.blue_proc.all_ws', vars.abyssea.blue_proc.ws_2206)",
        "log('Selected BLUE PROC pool:') and logArray(vars.abyssea.blue_proc.all_ws)"
      ],
      "comment": "Select the initial time window once; never change pool just because the clock advances mid-battle.",
      "delay": 0,
      "frequency": "infinity",
      "scope": "battle",
      "when": [
        "vars.abyssea.weapon_proc == 'blue'",
        "vars.abyssea.blue_proc._allowed",
        "arrayLength(vars.abyssea.blue_proc.all_ws) == 0"
      ]
    },
    {
      "commands": [
        "setVar('vars.abyssea.blue_proc._weapon_set_name', vars.abyssea.blue_proc.weapon_set_name or vars.abyssea.weapon_set_name or 'weapons')",
        "setVar('vars.abyssea.blue_proc._weapons', arrayLength(vars.abyssea.blue_proc[vars.abyssea.blue_proc._weapon_set_name]) > 0 and vars.abyssea.blue_proc[vars.abyssea.blue_proc._weapon_set_name] or vars.abyssea[vars.abyssea.blue_proc._weapon_set_name])",
        "abyssea.runBlueProc({state=vars.abyssea.blue_proc, enabled=vars.abyssea.blue_proc._allowed, is_active=\"vars.abyssea.weapon_proc == 'blue'\", all_ws=vars.abyssea.blue_proc.all_ws, weapons=vars.abyssea.blue_proc._weapons, weapon_set_name=vars.abyssea.blue_proc._weapon_set_name, on_stagger=vars.abyssea.blue_proc.on_stagger, allow_outside_abyssea=vars.abyssea.allow_outside_abyssea, swap_delay=vars.abyssea.blue_proc.swap_delay, refresh_delay=vars.abyssea.blue_proc.refresh_delay, equip_timeout=vars.abyssea.blue_proc.equip_timeout, empty_pass_delay=vars.abyssea.blue_proc.empty_pass_delay, ws_allow_list=vars.abyssea.ws_allow_list, ws_black_list=vars.abyssea.ws_black_list})"
      ],
      "delay": 1,
      "frequency": 0,
      "scope": "battle",
      "when": [
        "vars.abyssea.weapon_proc == 'blue'",
        "bt",
        "vars.abyssea.blue_proc._allowed",
        "arrayLength(vars.abyssea.blue_proc.all_ws) > 0"
      ]
    }
  ],
  "functions": [
    {
      "commands": [
        "setVar('vars.abyssea.weapon_proc', 'blue')",
        "setVar('vars.abyssea.blue_proc._allowed', true)",
        "setVar('vars.abyssea.blue_proc._blue_rotation', nil)",
        "setVar('vars.abyssea.blue_proc.all_ws', arrayMerge(vars.abyssea.blue_proc.ws_0614, vars.abyssea.blue_proc.ws_1422, vars.abyssea.blue_proc.ws_2206))",
        "log('Selected BLUE PROC pool:') and logArray(vars.abyssea.blue_proc.all_ws)"
