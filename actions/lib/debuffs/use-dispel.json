{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "use_dispel": {
      "buffs": null
    }
  },
  "actions": [
    {
      "when": [
        "bt and bt.distance <= constants.spell_distance",
        "canUseSpell('Dispel')",
        "arrayCount(vars.use_dispel.buffs) > 0",
        "hasBuff(bt, vars.use_dispel.buffs)",
        "(cursor and cursor.id == bt.id) or setTargetCursor(bt)"
      ],
      "commands": ["canUseSpell()"],
      "frequencies": 1
    }
  ]
}
