{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "use_dispel": {
      "buffs": null,
      "targets": null
    }
  },
  "actions": [
    {
      "when": [
        "bt and bt.distance <= constants.spell_distance",
        "canUseSpell('Dispel')",
        "arrayCount(vars.use_dispel.buffs) > 0",
        "hasBuff(bt, vars.use_dispel.buffs)"
      ],
      "commands": ["useSpell(bt)"],
      "precondition": ["arrayCount(vars.use_dispel.targets) <= 0"],
      "frequencies": 1
    },
    {
      "when": [
        "canUseSpell('Dispel')",
        "arrayCount(vars.use_dispel.buffs) > 0",
        "findMobWhere(vars.use_dispel.targets, 'hasBuff(mob, vars.use_dispel.buffs)', constants.spell_distance, true) or postpone(5)"
      ],
      "commands": ["useSpell(mob)"],
      "precondition": ["arrayCount(vars.use_dispel.targets) > 0"],
      "frequencies": 1
    }
  ]
}
