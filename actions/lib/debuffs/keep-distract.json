{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "keep_distract": {
      "spells": ["Distract III", "Distract II", "Distract"],
      "targets": null
    }
  },
  "actions": [
    {
      "when": [
        "bt and bt.distance <= constants.spell_distance",
        "bt and bt.valid_target",
        "hasSpell(vars.keep_distract.spells) and canUse(spell)",
        "not hasEffectOf(bt, spell)"
      ],
      "commands": [
        "useSpell(bt)",
        "postpone((spellRecast(spell.name) or 0) + 5)"
      ],
      "precondition": ["arrayCount(vars.keep_distract.targets) <= 0"],
      "frequency": 1,
      "scope": "battle"
    },
    {
      "when": [
        "hasSpell(vars.keep_distract.spells) and canUse(spell)",
        "findMobWhere(vars.keep_distract.targets, 'not hasEffectOf(mob, spell)', constants.spell_distance, true) or postpone(5)"
      ],
      "commands": [
        "useSpell(mob)",
        "postpone((spellRecast(spell.name) or 0) + 5)"
      ],
      "precondition": ["arrayCount(vars.keep_distract.targets) > 0"],
      "frequency": 1,
      "scope": "battle"
    }
  ]
}
