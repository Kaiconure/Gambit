{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "keep_bio": {
      "spells": ["Bio III", "Bio II", "Bio"],
      "targets": null
    }
  },
  "actions": [
    {
      "when": [
        "bt and bt.distance <= constants.spell_distance",
        "hasSpell(vars.keep_bio.spells) and canUse(spell)",
        "not hasEffectOf(bt, spell)"
      ],
      "commands": [
        "useSpell(bt)",
        "postpone((spellRecast(spell.name) or 0) + 5)"
      ],
      "precondition": ["arrayCount(vars.keep_bio.targets) <= 0"],
      "frequency": 1,
      "scope": "battle"
    },
    {
      "when": [
        "hasSpell(vars.keep_bio.spells) and canUse(spell)",
        "findMobWhere(vars.keep_bio.targets, 'not hasEffectOf(mob, spell)', constants.spell_distance, true) or postpone(5)"
      ],
      "commands": [
        "useSpell(mob)",
        "postpone((spellRecast(spell.name) or 0) + 5)"
      ],
      "precondition": ["arrayCount(vars.keep_bio.targets) > 0"],
      "frequency": 1,
      "scope": "battle"
    }
  ]
}
