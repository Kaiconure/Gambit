{
  "functions": [
    {
      "name": "checklists/abyssea/isgebind",
      "commands": ["setPanelTracking(vars.checklists.abyssea.isgebind)"],
      "max_iterations": 1,
      "silent": true
    }
  ],
  "vars": {
    "checklists": {
      "^abyssea": {
        "isgebind": [
          {
            "references": "compact"
          },
          {
            "id": "abyssea_isgebind",
            "name": "Abyssea Uleguerand: Isgebind",
            "checklist": [
              {
                "format": ["%s←%s (%s)", "color_item(\"Isgebind's Heart\")", "color_mob('Isgebind')", "color_pos('I-5')"],
                "id": "isgebinds_heart",
                "checked_when": ["findItem(\"Isgebind's Heart\")"]
              },
              {
                "format": ["   • %s←%s (%s)", "color_ki('Begrimed Dragon Hide')", "color_mob('Kur')", "color_pos('I-5')"],
                "id": "kur",
                "checked_when": ["findKeyItem('begrimed dragon hide')"]
              },
              {
                "format": ["You are %s for %s (%s)", "findKeyItem('begrimed dragon hide') and color_green('ready') or color_yellow('not ready')", "color_mob('Isgebind')", "color_npc('??? at I-5')"],
                "id": "isgebind",
                "checked_when": ["findKeyItem('begrimed dragon hide')"]
              }
            ]
          }
        ]
      }
    }
  }
}
