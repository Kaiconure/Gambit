                ],
                "id": "ferine_seal_head",
                "checked_when": ["findItem('Ferine Seal: Head')"]
              },
              {
                "format": [
                  "You are %s for %s (%s at %s, timed spawn)",
                  "color_green('ready')",
                  "color_mob('Ovni')",
                  "color_npc('???')",
                  "color_pos('K-5')"
                ],
                "id": "ovni",
                "checked_when": ["true"]
              }
            ]
          }
        ]
      }
    }
