          {
            "references": "compact"
          },
          {
            "id": "abyssea_ovni",
            "name": "Abyssea La Theine: Ovni",
            "checklist": [
              {
                "format": [
                  "%s←%s (%s at %s)",
                  "color_item('Card of Voyage')",
                  "color_mob('Ovni')",
                  "color_npc('???')",
                  "color_pos('K-5')"
                ],
                "id": "card_of_voyage",
                "checked_when": ["findItem('Card of Voyage')"]
              },
              {
                "format": [
                  "%s←%s (%s at %s)",
                  "color_item('Stone of Voyage')",
                  "color_mob('Ovni')",
                  "color_npc('???')",
                  "color_pos('K-5')"
                ],
                "id": "stone_of_voyage",
                "checked_when": ["findItem('Stone of Voyage')"]
              },
              {
                "format": [
                  "%s←%s (%s at %s)",
                  "color_item('Bale Seal: Hands')",
                  "color_mob('Ovni')",
                  "color_npc('???')",
                  "color_pos('K-5')"
                ],
                "id": "bale_seal_hands",
                "checked_when": ["findItem('Bale Seal: Hands')"]
              },
              {
                "format": [
                  "%s←%s (%s at %s)",
                  "color_item('Ferine Seal: Head')",
                  "color_mob('Ovni')",
