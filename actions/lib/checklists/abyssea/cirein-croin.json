{
  "functions": [
    {
      "name": "checklists/abyssea/cirein-croin",
      "commands": ["setPanelTracking(vars.checklists.abyssea.cirein_croin)"],
      "max_iterations": 1,
      "silent": true
    }
  ],
  "vars": {
    "checklists": {
      "^abyssea": {
        "cirein_croin": [
          {
            "references": "compact"
          },
          {
            "id": "abyssea_cirein_croin",
            "name": "Abyssea Misareaux: Cirein-croin",
            "checklist": [
              {
                "format": [
                  "%s←%s (%s at %s, %s)",
                  "color_ki('Glistening orobon liver')",
                  "color_mob('Cep-Kamuy')",
                  "color_npc('???')",
                  "color_pos('F-5')",
                  "color_npc('Conflux #05')"
                ],
                "id": "cep_kamuy",
                "checked_when": ["findKeyItem('glistening orobon liver')"]
              },
              {
                "format": [
                  "   • %s←%s (%s)",
                  "color_item('Orbn. Cheekmeat')",
                  "color_mob('Ancient Orobon')",
                  "color_pos('F-5')"
                ],
                "id": "ancient_orobon",
                "checked_when": ["findItem('Orbn. Cheekmeat')"]
              },
              {
                "format": [
                  "%s←%s (%s, %s) (%s)",
                  "color_ki('Doffed Poroggo hat')",
                  "color_mob('Heqet')",
                  "color_pos('I-6')",
                  "color_npc('Conflux #00')",
                  "color_number('10-15 min.')"
                ],
                "id": "heqet",
                "checked_when": ["findKeyItem('doffed poroggo hat')"]
              },
              {
                "format": [
                  "You are %s for %s (%s at %s, %s)",
                  "findKeyItem('glistening orobon liver') and findKeyItem('doffed poroggo hat') and color_green('ready') or color_yellow('not ready')",
                  "color_mob('Cirein-croin')",
                  "color_npc('???')",
                  "color_pos('H-5')",
                  "color_npc('Conflux #05')"
                ],
                "id": "cirein_croin",
                "checked_when": [
                  "findKeyItem('glistening orobon liver') and findKeyItem('doffed poroggo hat')"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
