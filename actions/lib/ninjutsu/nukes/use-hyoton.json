{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "ninjutsu": {
      "nukes": {
        "hyoton": {
          "spells": ["Hyoton: San", "Hyoton: Ni", "Hyoton: Ichi"]
        }
      }
    }
  },
  "actions": [
    {
      "when": [
        "bt",
        "not vars.ninjutsu.yellow_proc_only or runningAsFunction()",
        "not runningAsFunction() or functionIteration() == 1",
        "bt.distance <= 20",
        "hasSpell(vars.ninjutsu.nukes.hyoton.spells) and canUseSpell(spell)",
        "findItemInInventory('Tsurara', 'Inoshishinofuda') or \\",
        "  (findUsableItem('Toolbag (Tsura)') and freeInventorySlots() > 1 and useItem(me) and wait(1)) or \\",
        "  (findUsableItem('Toolbag (Ino)') and freeInventorySlots() > 1 and useItem(me) and wait(1))"
      ],
      "commands": [
        "log('Casting', spell.name, '(Ice damage + Fire resistance down) on', bt.name)",
        "useSpell(bt) and postpone(vars.ninjutsu.nukes.hyoton.frequency or vars.ninjutsu.nukes.frequency or 5)"
      ],
      "scope": "battle",
      "name": "use_hyoton"
    }
  ]
}
