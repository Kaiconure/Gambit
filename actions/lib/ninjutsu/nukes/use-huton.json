{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "ninjutsu": {
      "nukes": {
        "huton": {
          "spells": ["Huton: San", "Huton: Ni", "Huton: Ichi"]
        }
      }
    }
  },
  "actions": [
    {
      "when": [
        "bt",
        "not vars.ninjutsu.yellow_proc_only or runningAsFunction()",
        "not runningAsFunction() or functionIteration() == 1",
        "bt.distance <= 20",
        "hasSpell(vars.ninjutsu.nukes.huton.spells) and canUseSpell(spell)",
        "findItemInInventory('Kawahori-Ogi', 'Inoshishinofuda') or \\",
        "  (findUsableItem('Toolbag (Kawa)') and freeInventorySlots() > 1 and useItem(me) and wait(1)) or \\",
        "  (findUsableItem('Toolbag (Ino)') and freeInventorySlots() > 1 and useItem(me) and wait(1))"
      ],
      "commands": [
        "log('Casting', spell.name, '(Wind damage + Ice resistance down) on', bt.name)",
        "useSpell(bt) and postpone(vars.ninjutsu.nukes.huton.frequency or vars.ninjutsu.nukes.frequency or 5)"
      ],
      "scope": "battle",
      "name": "use_huton"
    }
  ]
}
