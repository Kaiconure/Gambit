{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "roles": {
      "main_healer": true,
      "backup_healer": false
    },
    "cure_sequence": {
      "suppress_curaga": null,
      "curaga_hpp": null,
      "curaga_member_count": null,
      "curaga_override_hpp": null,
      "gear": null
    }
  },
  "actions": [
    {
      "when": [
        "not vars.cure_sequence.suppress_curaga",
        "partyByMinField('hpp', vars.cure_sequence.curaga_hpp or 80)",
        "member_count >= (vars.cure_sequence.curaga_member_count or 3)",
        "not vars.cure_sequence.curaga_override_hpp or member.hpp > vars.cure_sequence.curaga_override_hpp",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Curaga IV', 'Curaga III', 'Curaga II', 'Curaga')"
      ],
      "commands": ["$macro:cure_member"],
      "frequency": 10,
      "comment": [
        "Casts curaga if enough people have health below a configured threshold. This takes",
        "priority over other healing, and can be overridden if a separate health level is",
        "configured via curaga_override_hpp. If this is set, curaga casting will be bypassed",
        "if the lowest member's health is below this number. This ensures that critically low",
        "health can be addressed first before group healing."
      ]
    },
    {
      "import": "heals/backup-cure-sequence"
    },
    {
      "when": [
        "partyByMinField('hpp', 80)",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Cure III', 'Cure II', 'Cure')"
      ],
      "commands": ["$macro:cure_member"],
      "frequency": 3
    }
  ]
}
