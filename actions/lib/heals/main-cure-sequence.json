{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "roles": {
      "main_healer": true,
      "backup_healer": false
    },
    "cure_sequence": {
      "suppress_curaga": null
    }
  },
  "actions": [
    {
      "import": "heals/backup-cure-sequence"
    },
    {
      "when": [
        "not vars.cure_sequence.suppress_curaga",
        "partyCount('hpp <= 60 and distance <= 10') >= 3 and canUse('Curaga III', 'Curaga II', 'Curaga')"
      ],
      "commands": "use(me)",
      "frequency": 10
    },
    {
      "when": [
        "partyAny('hpp <= 80') and canUse('Cure III', 'Cure II', 'Cure')",
        "member.distance <= constants.spell_distance"
      ],
      "commands": ["use()"],
      "frequency": 1
    }
  ]
}
