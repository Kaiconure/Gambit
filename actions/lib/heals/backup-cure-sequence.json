{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "roles": {
      "backup_healer": true
    },
    "cure_sequence": {
      "suppress_curaga": null,
      "gear": null
    }
  },
  "actions": [
    {
      "import": "heals/emergency-cure-sequence"
    },
    {
      "when": [
        "vars.roles.main_healer or (not skillchaining() and not partyUsingWeaponSkill())",
        "partyByMinField('hpp', 60)",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Cure IV', 'Cure III', 'Cure II', 'Cure')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 2
    },
    {
      "import": "heals/remove-sleep"
    }
  ]
}
