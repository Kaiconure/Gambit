{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "roles": {
      "backup_healer": true
    },
    "cure_sequence": {
      "silena_targets": null,
      "suppress_curaga": null,
      "gear": null
    }
  },
  "actions": [
    {
      "imports": ["heals/remove-doom"]
    },
    {
      "when": ["hasEffect('Silence') and canUseItem('Echo Drops', 'Remedy')"],
      "commands": ["use(me)"],
      "frequency": 1
    },
    {
      "when": ["hasEffect('Paralysis') and canUseItem('Paralyna')"],
      "commands": ["use(me)"],
      "frequency": 1
    },
    {
      "when": [
        "not vars.cure_sequence.suppress_curaga",
        "partyByMinField('hpp', 50) and member_count >= 3",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Curaga IV', 'Curaga III', 'Curaga II', 'Curaga')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 10
    },
    {
      "when": [
        "partyByMinField('hpp', 30)",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Cure VI', 'Cure V', 'Cure IV', 'Cure III', 'Cure II', 'Cure')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 1
    },
    {
      "when": [
        "partyByMinField('hpp', 50)",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Cure V', 'Cure IV', 'Cure III', 'Cure II', 'Cure')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 1
    },
    {
      "imports": [
        "heals/remove-plague",
        "heals/remove-petrify",
        "heals/remove-paralysis"
      ]
    },
    {
      "imports": ["heals/remove-poison"]
    }
  ]
}
