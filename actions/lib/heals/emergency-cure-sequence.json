{
  "about": {
    "author": "@Kaiconure"
  },
  "vars": {
    "roles": {
      "backup_healer": true
    },
    "cure_sequence": {
      "silena_targets": null,
      "suppress_curaga": null,
      "gear": null
    }
  },
  "actions": [
    {
      "import": "heals/remove-doom"
    },
    {
      "when": ["hasEffect('Silence') and canUseItem('Echo Drops', 'Remedy')"],
      "commands": ["use(me)"],
      "frequency": 1
    },
    {
      "when": ["hasEffect('Paralysis') and canUse('Paralyna', 'Remedy')"],
      "commands": ["use(me)"],
      "frequency": 1
    },
    {
      "import": "heals/remove-petrify"
    },
    {
      "when": [
        "not vars.cure_sequence.suppress_curaga",
        "partyByMinField('hpp', 50) and member_count >= 3",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Curaga IV', 'Curaga III', 'Curaga II', 'Curaga')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 10
    },
    {
      "when": [
        "partyByMinField('hpp', 30)",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Cure VI', 'Cure V', 'Cure IV', 'Cure III', 'Cure II', 'Cure')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 1
    },
    {
      "when": [
        "partyByMinField('hpp', 50)",
        "member.distance <= constants.spell_distance",
        "canUseSpell('Cure V', 'Cure IV', 'Cure III', 'Cure II', 'Cure')"
      ],
      "commands": [
        "vars.cure_sequence.gear and vars.cure_sequence.gear.casting and equipMany(vars.cure_sequence.gear.casting)",
        "useSpell(member)",
        "vars.cure_sequence.gear and vars.cure_sequence.gear.battle and equipMany(vars.cure_sequence.gear.battle)"
      ],
      "frequency": 1
    },
    {
      "when": ["partyHasBuff('Paralysis') and canUse('Paralyna')"],
      "commands": ["removeEffect(member)"],
      "frequency": 1
    },
    {
      "when": [
        "arrayCount(vars.cure_sequence.silena_targets) > 0 and canUse('Silena')",
        "partyByName(vars.cure_sequence.silena_targets)",
        "member.hasEffect('Silence') "
      ],
      "commands": ["removeEffect(member)"],
      "frequency": 1
    },
    {
      "when": ["partyHasBuff('Poison') and canUse('Poisona')"],
      "commands": ["removeEffect(member)"],
      "frequency": 3
    }
  ]
}
