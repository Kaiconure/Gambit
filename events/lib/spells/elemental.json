      {
        "when": [
          "event.elemental",
          "canMagicBurst(event)",
          "vars.gear.spells.burst[event.name] and vars.gear.spells.burst[event.name].mid"
        ],
        "commands": [
          "equipMany(vars.gear.spells.burst[event.name].mid)",
