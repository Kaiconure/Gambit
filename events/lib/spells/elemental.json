        "commands": [
          "equipMany(vars.gear.spells.elemental.mid)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-elemental-mid"
      },
      {
        "when": [
          "event.elemental",
          "vars.gear.spells.elemental[event.name] and vars.gear.spells.elemental[event.name].mid"
        ],
        "commands": [
          "equipMany(vars.gear.spells.elemental[event.name].mid)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-elemental-named-mid"
