{
  "vars": {
    "gear": {
      "spells": {
        "burst": {
          "pre": null,
          "mid": null
        },
        "elemental": {
          "pre": null,
          "mid": null
        }
      }
    }
  },
  "spells": {
    "pre": [
      {
        "when": ["event.elemental", "vars.gear.spells.elemental.pre"],
        "commands": [
          "equipMany(vars.gear.spells.elemental.pre)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-elemental-pre"
      },
      {
        "when": [
          "event.elemental",
          "vars.gear.spells.elemental[event.name] and vars.gear.spells.elemental[event.name].pre"
        ],
        "commands": [
          "equipMany(vars.gear.spells.elemental[event.name].pre)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-elemental-named-pre"
      },
      {
        "when": [
          "event.elemental",
          "canMagicBurst(event)",
          "vars.gear.spells.burst.pre"
        ],
        "commands": [
          "equipMany(vars.gear.spells.burst.pre)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-burst-pre"
      },
      {
        "when": [
          "event.elemental",
          "canMagicBurst(event)",
          "vars.gear.spells.burst[event.name] and vars.gear.spells.burst[event.name].pre"
        ],
        "commands": [
          "equipMany(vars.gear.spells.burst[event.name].pre)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-burst-named-pre"
      }
    ],
    "mid": [
      {
