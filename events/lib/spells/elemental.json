      {
        "when": [
          "event.elemental",
          "canMagicBurst(event)",
          "vars.gear.spells.burst.mid"
        ],
        "commands": [
          "equipMany(vars.gear.spells.burst.mid)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-burst-mid"
