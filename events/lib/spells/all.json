{
  "loading": {
    "actions": [
      {
        "commands": [
          "setVar('gear.spells', resourceAliasKeys(vars.gear.spells))"
        ],
        "id": "gear-spells-name-aliases"
      },
      {
        "commands": [
          "setVar('gear.spells.magic_burst', resourceAliasKeys(vars.gear.spells.magic_burst))"
        ],
        "id": "gear-spells-magic_burst-name-aliases"
      }
    ]
  },
  "vars": {
    "gear": {
      "spells": {}
    }
  },
  "imports": [
    "lib/spells/pre",
    "lib/spells/curing",
    "lib/spells/divine",
    "lib/spells/enfeebling",
    "lib/spells/enhancing",
    "lib/spells/elemental",
    "lib/spells/buff-overlays"
  ],
  "spells": {
    "pre": [
      {
        "when": [
          "vars.gear.spells[event.name] and vars.gear.spells[event.name].pre"
        ],
        "commands": [
          "equipMany(vars.gear.spells[event.name].pre)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-named-pre"
      }
    ],
    "mid": [
      {
        "when": [
          "vars.gear.spells[event.name] and vars.gear.spells[event.name].mid"
        ],
        "commands": [
          "equipMany(vars.gear.spells[event.name].mid)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "spells-named-mid"
      }
    ]
  }
}
