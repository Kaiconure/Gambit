{
  "vars": {
    "gear": {},
    "post_equip": {
      "restore_snapshot": false
    }
  },
  "spells": {
    "post": [
      {
        "when": [
          "vars.post_equip.restore_snapshot",
          "vars._.eq_stack[1] and vars._.eq_stack[1].event_baseline"
        ],
        "commands": ["while #vars._.eq_stack > 0 do equipPop() end"],
        "id": "post-equip-spells-restore"
      },
      {
        "when": ["me.is_idle and vars.gear.idle"],
        "commands": [
          "equipMany(vars.gear.idle)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "post-equip-spells-idle"
      },
      {
        "when": ["me.is_engaged and vars.gear.battle"],
        "commands": [
          "equipMany(vars.gear.battle)",
          "equipment_set and equipment_set.meta and equipment_set.meta.stop and stopEvent()"
        ],
        "id": "post-equip-spells-battle"
      }
    ]
  },
